import pygame
from random import choice




pygame.init()
window_width = 500
window_height = 500
background = (220, 200, 255)
RED = (255, 0, 0)
black = (0, 0, 0)

window = pygame.display.set_mode((window_width, window_height))

window.fill(background)

clock = pygame.time.Clock()




class TextArea():
    def __init__(self, x=0, y=0, width=10, height=10, color=None):
        self.rect = pygame.Rect(x, y, width, height)
        self.fill_color = color

    #Установить текст на карточке


    def set_text(self, text, fsize = 12, text_color = black):
        self.text = text
        self.image = pygame.font.Font(None, fsize).render(self.text, True, text_color)



    #Отрисовать карточку

    def draw(self, shift_x=0, shift_y=0):
        pygame.draw.rect(window, self.fill_color, self.rect)
        window.blit(self.image, (self.rect.x + shift_x, self.rect.y + shift_y))

question = ['Что изучаешь в Алгоритмике?', 'Что растёт на яблоне?', 'На каком языке говорят во франции?']
answers = ['Python', 'Яблоки', 'На французском']









quest_card = TextArea(120, 100, 290, 70, RED)
quest_card.set_text('ВОПРОС:', 75)
answer_card = TextArea(120, 200, 290, 70, RED)
answer_card.set_text('ОТВЕТ:', 75)

quest_card.draw(10, 10)
answer_card.draw(10, 10)




# Главный игровой цикл


closing = True


while closing == True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            closing = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_q:
                question1 = choice(question)
                quest_card.set_text(question1, 30)
                quest_card.draw(10, 10)
            if event.key == pygame.K_a:
                answer = choice(answers)
                answer_card.set_text(answer, 30)
                answer_card.draw(10, 10)

    quest_card.draw(10, 10)
    answer_card.draw(10, 10)
    clock.tick(40)
    pygame.display.update()
        
